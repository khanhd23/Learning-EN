<?xml version="1.0" encoding="utf-8"?>
<!-- Splash logo (288dp; Android 12+ shows only the centre 192dp circle): the panda illustration
     (splash_panda.webp, 112dp, transparent) above the LingoMori wordmark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_wordmark" />
    <item android:width="112dp" android:height="112dp" android:top="60dp" android:gravity="top|center_horizontal">
        <bitmap android:src="@drawable/splash_panda" android:filter="true" android:antialias="true" />
    </item>
</layer-list>
