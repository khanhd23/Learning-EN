<?xml version="1.0" encoding="utf-8"?>
<!-- Splash logo: ONE bitmap (panda + LingoMori wordmark, 288dp canvas, transparent, content inside
     a 176dp circle) so every launcher scales both parts together. Two layers scaled unevenly on
     MIUI: the panda grew over the wordmark and was cut off. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/splash_logo_img"
    android:gravity="center"
    android:filter="true"
    android:antialias="true" />
