<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: the panda illustration (publisher artwork) as a full-bleed background layer,
     WebP per density (mipmap-*/ic_launcher_art.webp). Themed icons (Android 13) use the vector
     panda face as the monochrome layer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
